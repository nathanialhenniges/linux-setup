# Lightweight Hyprland session for MacBookAir7,2.
$mainMod = SUPER

monitor = ,preferred,auto,1

input {
    kb_layout = us
    follow_mouse = 1

    touchpad {
        natural_scroll = true
        tap-to-click = true
        disable_while_typing = true
    }
}

general {
    gaps_in = 5
    gaps_out = 10
    border_size = 2
    col.active_border = rgba(00acedee)
    col.inactive_border = rgba(52607a88)
    resize_on_border = true
}

decoration {
    rounding = 9
    shadow {
        enabled = false
    }
    blur {
        enabled = false
    }
}

misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
}

exec-once = waybar
exec-once = mako
exec-once = powerprofilesctl set power-saver
exec-once = /usr/lib/hyprpolkitagent/hyprpolkitagent
exec-once = nm-applet --indicator
exec-once = blueman-applet
exec-once = hyprpaper
exec-once = hypridle

bind = $mainMod, Return, exec, ghostty
bind = $mainMod, Space, exec, wofi --show drun
bind = $mainMod, E, exec, thunar
bind = $mainMod, Q, killactive
bind = $mainMod, L, exec, hyprlock
bind = $mainMod, F, fullscreen, 0

# Temporarily stop local shortcuts from intercepting a Chrome Remote Desktop session.
bind = $mainMod, R, submap, remote_mac
submap = remote_mac
bind = , Escape, submap, reset
submap = reset

bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4

bind = , Print, exec, grim - | wl-copy --type image/png
bind = $mainMod SHIFT, S, exec, grim -g "$(slurp)" - | wl-copy --type image/png

bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bind = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bind = , XF86AudioPlay, exec, playerctl play-pause
bind = , XF86AudioPrev, exec, playerctl previous
bind = , XF86AudioNext, exec, playerctl next
bindel = , XF86MonBrightnessUp, exec, brightnessctl set 5%+
bindel = , XF86MonBrightnessDown, exec, brightnessctl set 5%-
